# Server Configuration
PROJECT_NAME="ResearchMind — AI Research Intelligence & RAG Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security & CORS
SECRET_KEY="researchmind_super_secret_key_change_in_production"
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="researchmind_db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/researchmind_db"

# LLM Providers Configuration
# Supported providers: "openai", "gemini", "ollama", "mock"
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Embedding Model Configuration
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# Vector Database Configuration
VECTOR_STORE_TYPE="faiss" # "faiss" or "chroma"
FAISS_INDEX_PATH="data/embeddings/faiss_index.bin"
CHROMA_DB_DIR="data/embeddings/chroma_db"

# Data Storage Paths
RAW_DATA_DIR="data/raw"
PROCESSED_DATA_DIR="data/processed"
MODELS_DIR="ml/models"
